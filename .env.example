# Copy these into Vercel: Project → Settings → Environment Variables.
# (To test email on your own computer, copy this file to .env.local and fill it in.)

# From resend.com → API Keys. Starts with "re_". Keep it secret.
RESEND_API_KEY=

# Where demo requests get emailed. Separate several addresses with commas.
DEMO_NOTIFY_EMAIL=you@yourcompany.com

# Optional. Leave blank to use Resend's test sender (onboarding@resend.dev),
# which can only email the address you signed up to Resend with.
# After verifying your domain in Resend, use something like:
# DEMO_FROM_EMAIL=DesertDesk <demos@yourdomain.com>
DEMO_FROM_EMAIL=
