# Copy this file to .env (in this same folder) and paste in your keys.
# .env is git-ignored, so your keys never get committed.

# Alpaca PAPER trading keys. Leave blank to run in demo mode with simulated prices.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Optional: Claude API key (console.anthropic.com) to turn on news reading.
# Leave blank to run without news; the News bot then sits idle.
ANTHROPIC_API_KEY=
